{
  "name": "@state-dynamics-engine/simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "State Dynamics Lab: an interactive interface to the reference engine.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types tests/session.ts && node --experimental-strip-types tests/probe.ts",
    "verify:provenance": "node scripts/verify-provenance.mjs",
    "check": "npm run verify:provenance && npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
